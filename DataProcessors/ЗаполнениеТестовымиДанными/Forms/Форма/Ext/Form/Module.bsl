           &НаКлиенте
Процедура ЗаполнитьБазу(Команда)
	Отчет = ЗаполнитьБазуНаСервере();
	ПоказатьПредупреждение(, Отчет);
КонецПроцедуры

&НаСервере
Функция ЗаполнитьБазуНаСервере()

	// Сначала полностью очищаем старые тестовые данные, чтобы не было дублей
	ОчиститьБазуНаСервере();

	// 1. Константы
	Константы.НаименованиеУчебногоЗаведения.Установить("ФГБОУ ВО ""Университет информационных технологий""");
	Константы.ПорогНеуважительныхПропусковВЧасах.Установить(16);
	Константы.ПродолжительностьАкадемическогоЧаса.Установить(45);

	// 2. Иерархический справочник СтруктурныеПодразделения (2 группы + 10 кафедр)
	ФакИТ = СоздатьГруппуСправочника("СтруктурныеПодразделения", "Факультет информационных технологий");
	ФакЭк = СоздатьГруппуСправочника("СтруктурныеПодразделения", "Факультет цифровой экономики");
	Кафедры = Новый Массив;
	Для Индекс = 1 По 10 Цикл
		Об = Справочники.СтруктурныеПодразделения.СоздатьЭлемент();
		Об.Наименование = "Кафедра информационных систем №" + Индекс;
		Об.КраткоеНаименование = "КИС-" + Индекс;
		Об.Родитель = ?(Индекс <= 5, ФакИТ, ФакЭк);
		Об.Записать();
		Кафедры.Добавить(Об.Ссылка);
	КонецЦикла;

	// 3. Иерархический справочник Аудитории (2 корпуса + 10 аудиторий)
	КорпА = СоздатьГруппуСправочника("Аудитории", "Учебный корпус А");
	КорпБ = СоздатьГруппуСправочника("Аудитории", "Лабораторный корпус Б");
	Аудитории = Новый Массив;
	Для Индекс = 1 По 10 Цикл
		Об = Справочники.Аудитории.СоздатьЭлемент();
		Об.Наименование = "Ауд. " + (100 + Индекс * 10);
		Об.Корпус = ?(Индекс <= 5, "Корпус А", "Корпус Б");
		Об.Вместимость = 25 + Индекс * 5;
		Об.Родитель = ?(Индекс <= 5, КорпА, КорпБ);
		Об.Записать();
		Аудитории.Добавить(Об.Ссылка);
	КонецЦикла;

	// 4. Иерархический справочник Дисциплины (2 цикла + 10 дисциплин)
	ЦиклБаз = СоздатьГруппуСправочника("Дисциплины", "Базовый цикл");
	ЦиклПроф = СоздатьГруппуСправочника("Дисциплины", "Профильный цикл");
	НазвДисц = Новый Массив;
	НазвДисц.Добавить("Программирование на 1С");
	НазвДисц.Добавить("Базы данных");
	НазвДисц.Добавить("Информационные системы");
	НазвДисц.Добавить("Алгоритмы и структуры данных");
	НазвДисц.Добавить("Операционные системы");
	НазвДисц.Добавить("Компьютерные сети");
	НазвДисц.Добавить("Информационная безопасность");
	НазвДисц.Добавить("Проектирование ПО");
	НазвДисц.Добавить("Тестирование ПО");
	НазвДисц.Добавить("Управление ИТ-проектами");

	Дисциплины = Новый Массив;
	Для Индекс = 0 По 9 Цикл
		Об = Справочники.Дисциплины.СоздатьЭлемент();
		Об.Наименование = НазвДисц[Индекс];
		Об.КодДисциплины = "Б1.О.0" + (Индекс + 1);
		Об.Кафедра = Кафедры[Индекс];
		Об.Родитель = ?(Индекс < 5, ЦиклБаз, ЦиклПроф);
		Об.Записать();
		Дисциплины.Добавить(Об.Ссылка);
	КонецЦикла;

	// 5. Иерархический справочник УчебныеГруппы (2 курса + 10 групп)
	Курс3 = СоздатьГруппуСправочника("УчебныеГруппы", "3 курс (очная)");
	Курс4 = СоздатьГруппуСправочника("УчебныеГруппы", "4 курс (очная)");
	Группы = Новый Массив;
	Для Индекс = 1 По 10 Цикл
		Об = Справочники.УчебныеГруппы.СоздатьЭлемент();
		Об.Наименование = "ИСТ-" + ?(Индекс <= 5, "30", "40") + Индекс;
		Об.Подразделение = Кафедры[Индекс - 1];
		Об.ФормаОбучения = Перечисления.ФормыОбучения.Очная;
		Об.Курс = ?(Индекс <= 5, 3, 4);
		Об.ГодПоступления = ?(Индекс <= 5, 2024, 2023);
		Об.Родитель = ?(Индекс <= 5, Курс3, Курс4);
		Об.Записать();
		Группы.Добавить(Об.Ссылка);
	КонецЦикла;

	// 6. Физические лица (30), Сотрудники деканата (10), Преподаватели (10), Обучающиеся (10)
	Сотрудники = Новый Массив;
	Для Индекс = 1 По 10 Цикл
		ФЛ = СоздатьФизЛицо("Сотрудник Деканата " + Индекс, Дата(1980 + Индекс, 3, 10), "+790010000" + Индекс);
		Об = Справочники.СотрудникиДеканата.СоздатьЭлемент();
		Об.Наименование = ФЛ.Наименование;
		Об.ФизЛицо = ФЛ;
		Об.Подразделение = Кафедры[Индекс - 1];
		Об.Должность = ?(Индекс <= 5, "Методист", "Куратор группы");
		Об.Записать();
		Сотрудники.Добавить(Об.Ссылка);
	КонецЦикла;

	Преподаватели = Новый Массив;
	Для Индекс = 1 По 10 Цикл
		ФЛ = СоздатьФизЛицо("Преподаватель " + Индекс, Дата(1975 + Индекс, 5, 15), "+790020000" + Индекс);
		Об = Справочники.Преподаватели.СоздатьЭлемент();
		Об.Наименование = ФЛ.Наименование;
		Об.ФизЛицо = ФЛ;
		Об.Кафедра = Кафедры[Индекс - 1];
		Об.Должность = ?(Индекс <= 5, "Доцент", "Старший преподаватель");
		Об.ТабельныйНомер = "ТН-00" + Индекс;
		Об.Записать();
		Преподаватели.Добавить(Об.Ссылка);
	КонецЦикла;

	Обучающиеся = Новый Массив;
	Для Индекс = 1 По 10 Цикл
		ФЛ = СоздатьФизЛицо("Студент " + Индекс, Дата(2004, 1 + (Индекс % 11), 5 + Индекс), "+790030000" + Индекс);
		Об = Справочники.Обучающиеся.СоздатьЭлемент();
		Об.Наименование = ФЛ.Наименование;
		Об.ФизЛицо = ФЛ;
		Об.НомерСтудБилета = "СБ-2026-" + Формат(Индекс, "ЧЦ=3; ЧВН=");
		Об.УчебнаяГруппа = Группы[Индекс - 1];
		Об.Куратор = Сотрудники[Индекс - 1];
		Об.Записать();
		Обучающиеся.Добавить(Об.Ссылка);
	КонецЦикла;

	// 7. Направления (10), Семестры (10), Учебные планы (10), Виды занятий (10)
	Направления = Новый Массив;
	Для Индекс = 1 По 10 Цикл
		Об = Справочники.НаправленияПодготовки.СоздатьЭлемент();
		Об.Наименование = "Прикладная информатика (профиль " + Индекс + ")";
		Об.КодНаправления = "09.03.0" + (1 + (Индекс % 4));
		Об.Профиль = "Корпоративные ИС №" + Индекс;
		Об.Записать();
		Направления.Добавить(Об.Ссылка);
	КонецЦикла;

	Семестры = Новый Массив;
	Для Индекс = 1 По 10 Цикл
		Об = Справочники.Семестры.СоздатьЭлемент();
		Об.Наименование = "Семестр №" + Индекс + " (2026/2027)";
		Об.ДатаНачала = Дата(2026, 9, 1);
		Об.ДатаОкончания = Дата(2026, 12, 31);
		Об.УчебныйГод = "2026/2027";
		Об.Записать();
		Семестры.Добавить(Об.Ссылка);
	КонецЦикла;

	Планы = Новый Массив;
	Для Индекс = 1 По 10 Цикл
		Об = Справочники.УчебныеПланы.СоздатьЭлемент();
		Об.Наименование = "УП-2026-" + Индекс;
		Об.НаправлениеПодготовки = Направления[Индекс - 1];
		Об.ФормаОбучения = Перечисления.ФормыОбучения.Очная;
		Об.ГодНабора = 2024;
		Об.Записать();
		Планы.Добавить(Об.Ссылка);
	КонецЦикла;

	ВидыЗанятий = Новый Массив;
	Для Индекс = 1 По 10 Цикл
		Об = Справочники.ВидыЗанятий.СоздатьЭлемент();
		Об.Наименование = ?(Индекс <= 5, "Лабораторная работа №" + Индекс, "Лекция №" + Индекс);
		Об.ТребуетОтработки = (Индекс <= 5);
		Об.Записать();
		ВидыЗанятий.Добавить(Об.Ссылка);
	КонецЦикла;

	// 8. Сетка звонков (10), Причины пропусков (10), Типы справок (10), Шаблоны (10)
	Пары = Новый Массив;
	Для Индекс = 1 По 10 Цикл
		Об = Справочники.СеткаЗвонков.СоздатьЭлемент();
		Об.Наименование = "Пара №" + Индекс;
		Об.НомерПары = Индекс;
		Об.ВремяНачала = Формат(8 + Индекс, "ЧЦ=2; ЧВН=") + ":00";
		Об.ВремяОкончания = Формат(9 + Индекс, "ЧЦ=2; ЧВН=") + ":30";
		Об.КоличествоАкадемЧасов = 2;
		Об.Записать();
		Пары.Добавить(Об.Ссылка);
	КонецЦикла;

	ПричиныУв = Новый Массив;
	ПричиныНеув = Новый Массив;
	Для Индекс = 1 По 10 Цикл
		Об = Справочники.ПричиныПропусков.СоздатьЭлемент();
		Уваж = (Индекс <= 5);
		Об.Наименование = ?(Уваж, "Уважительная причина №" + Индекс, "Неуважительный пропуск №" + Индекс);
		Об.Уважительная = Уваж;
		Об.ТребуетПодтверждающийДокумент = Уваж;
		Об.Записать();
		Если Уваж Тогда
			ПричиныУв.Добавить(Об.Ссылка);
		Иначе
			ПричиныНеув.Добавить(Об.Ссылка);
		КонецЕсли;
	КонецЦикла;

	ТипыСправок = Новый Массив;
	Для Индекс = 1 По 10 Цикл
		Об = Справочники.ТипыОправдательныхДокументов.СоздатьЭлемент();
		Об.Наименование = "Оправдательный документ тип №" + Индекс;
		Об.СрокПодачиВДнях = 3 + Индекс;
		Об.Записать();
		ТипыСправок.Добавить(Об.Ссылка);
	КонецЦикла;

	Шаблоны = Новый Массив;
	Для Индекс = 1 По 10 Цикл
		Об = Справочники.ШаблоныУведомлений.СоздатьЭлемент();
		Об.Наименование = "Шаблон предупреждения №" + Индекс;
		Об.ТемаПисьма = "Превышение порога пропусков — [ФИО]";
		Об.ТекстШаблона = "Уважаемый(ая) [ФИО] (группа [Группа]), в [Вуз] зафиксировано [Часы] ч. пропусков (порог [Порог] ч.).";
		Об.Записать();
		Шаблоны.Добавить(Об.Ссылка);
	КонецЦикла;

	// 9. Документы: Зачисление (10), Перевод (10), Утверждение УП (10), Расписание (10), Изменение (10)
	Для Индекс = 0 По 9 Цикл
		ДокЗач = Документы.ЗачислениеОбучающихся.СоздатьДокумент();
		ДокЗач.Дата = Дата(2026, 9, 1, 9, Индекс, 0);
		ДокЗач.УчебнаяГруппа = Группы[Индекс];
		ДокЗач.НомерПриказа = "ПР-ЗАЧ-" + (Индекс + 1);
		ДокЗач.Ответственный = Сотрудники[Индекс];
		Стр = ДокЗач.Обучающиеся.Добавить();
		Стр.Обучающийся = Обучающиеся[Индекс];
		Стр.НомерСтудБилета = Обучающиеся[Индекс].НомерСтудБилета;
		ДокЗач.Записать(РежимЗаписиДокумента.Проведение);

		ДокПер = Документы.ПереводОтчислениеОбучающихся.СоздатьДокумент();
		ДокПер.Дата = Дата(2026, 9, 2, 10, Индекс, 0);
		ДокПер.НовыйСтатус = Перечисления.СтатусыОбучающегося.Обучается;
		ДокПер.НоваяГруппа = Группы[Индекс];
		ДокПер.НомерПриказа = "ПР-ПЕР-" + (Индекс + 1);
		ДокПер.Причина = "Подтверждение перевода на новый учебный год";
		ДокПер.Ответственный = Сотрудники[Индекс];
		СтрП = ДокПер.Обучающиеся.Добавить();
		СтрП.Обучающийся = Обучающиеся[Индекс];
		СтрП.ПредыдущаяГруппа = Группы[Индекс];
		ДокПер.Записать(РежимЗаписиДокумента.Проведение);

		ДокУП = Документы.УтверждениеУчебногоПлана.СоздатьДокумент();
		ДокУП.Дата = Дата(2026, 9, 3, 10, Индекс, 0);
		ДокУП.УчебныйПлан = Планы[Индекс];
		ДокУП.УчебнаяГруппа = Группы[Индекс];
		ДокУП.Семестр = Семестры[Индекс];
		ДокУП.Ответственный = Сотрудники[Индекс];
		СтрУП = ДокУП.ДисциплиныПлана.Добавить();
		СтрУП.Дисциплина = Дисциплины[Индекс];
		СтрУП.ВидЗанятия = ВидыЗанятий[0];
		СтрУП.ЧасовПоПлану = 72;
		ДокУП.Записать(РежимЗаписиДокумента.Проведение);

		ДокРасп = Документы.НазначениеРасписанияЗанятий.СоздатьДокумент();
		ДокРасп.Дата = Дата(2026, 9, 4, 10, Индекс, 0);
		ДокРасп.УчебнаяГруппа = Группы[Индекс];
		ДокРасп.Семестр = Семестры[Индекс];
		ДокРасп.Ответственный = Сотрудники[Индекс];
		СтрР = ДокРасп.Занятия.Добавить();
		СтрР.ДатаЗанятия = Дата(2026, 10, 1 + Индекс);
		СтрР.Пара = Пары[0];
		СтрР.Дисциплина = Дисциплины[Индекс];
		СтрР.Преподаватель = Преподаватели[Индекс];
		СтрР.ВидЗанятия = ВидыЗанятий[0];
		СтрР.Аудитория = Аудитории[Индекс];
		ДокРасп.Записать(РежимЗаписиДокумента.Проведение);

		ДокИзм = Документы.ИзменениеОтменаЗанятий.СоздатьДокумент();
		ДокИзм.Дата = Дата(2026, 9, 5, 10, Индекс, 0);
		ДокИзм.УчебнаяГруппа = Группы[Индекс];
		ДокИзм.ПричинаИзменения = "Перенос в компьютерный класс";
		ДокИзм.Ответственный = Сотрудники[Индекс];
		СтрИ = ДокИзм.Изменения.Добавить();
		СтрИ.ДатаЗанятия = Дата(2026, 10, 1 + Индекс);
		СтрИ.Пара = Пары[0];
		СтрИ.Дисциплина = Дисциплины[Индекс];
		СтрИ.Преподаватель = Преподаватели[Индекс];
		СтрИ.ВидЗанятия = ВидыЗанятий[0];
		СтрИ.Аудитория = Аудитории[Индекс];
		СтрИ.Отменено = Ложь;
		ДокИзм.Записать(РежимЗаписиДокумента.Проведение);
	КонецЦикла;

	// 10. Ведомости посещаемости (20 шт.)
	Для Индекс = 0 По 9 Цикл
		Для Сдвиг = 1 По 2 Цикл
			ДокВед = Документы.ВедомостьПосещаемостиЗанятия.СоздатьДокумент();
			ДокВед.Дата = Дата(2026, 10, 10 + Сдвиг, 10 + Индекс, 0, 0);
			ДокВед.УчебнаяГруппа = Группы[Индекс];
			ДокВед.Дисциплина = Дисциплины[Индекс];
			ДокВед.Преподаватель = Преподаватели[Индекс];
			ДокВед.ВидЗанятия = ВидыЗанятий[0];
			ДокВед.Пара = Пары[Сдвиг - 1];
			ДокВед.Аудитория = Аудитории[Индекс];
			ДокВед.КоличествоЧасов = ?(Индекс < 3, 10, 2);

			СтрВ = ДокВед.Посещаемость.Добавить();
			СтрВ.Обучающийся = Обучающиеся[Индекс];
			СтрВ.Статус = Перечисления.СтатусыПосещаемости.Отсутствовал;
			СтрВ.ПричинаПропуска = ПричиныНеув[0];
			ДокВед.Записать(РежимЗаписиДокумента.Проведение);
		КонецЦикла;
	КонецЦикла;

	// 11. Оправдательные документы (10), Отработка (10), Предупреждения (10), Акты (10), Закрытие (10)
	СправкиСсылки = Новый Массив;
	ПредупрежденияСсылки = Новый Массив;
	Для Индекс = 0 По 9 Цикл
		ДокСпр = Документы.РегистрацияОправдательногоДокумента.СоздатьДокумент();
		ДокСпр.Дата = Дата(2026, 10, 20, 10, Индекс, 0);
		ДокСпр.Обучающийся = Обучающиеся[Индекс];
		ДокСпр.ТипДокумента = ТипыСправок[Индекс];
		ДокСпр.ПричинаПропуска = ПричиныУв[0];
		ДокСпр.НомерСправки = "СПР-2026-" + (Индекс + 1);
		ДокСпр.ДатаНачала = Дата(2026, 10, 11);
		ДокСпр.ДатаОкончания = Дата(2026, 10, 11);
		ДокСпр.СтатусСправки = ?(Индекс >= 3, Перечисления.СтатусыСправки.Принята, Перечисления.СтатусыСправки.НаПроверке);
		ДокСпр.Ответственный = Сотрудники[Индекс];
		ДокСпр.Записать(РежимЗаписиДокумента.Проведение);
		СправкиСсылки.Добавить(ДокСпр.Ссылка);

		ДокОтр = Документы.ОтработкаПропущенныхЗанятий.СоздатьДокумент();
		ДокОтр.Дата = Дата(2026, 10, 22, 11, Индекс, 0);
		ДокОтр.Обучающийся = Обучающиеся[Индекс];
		ДокОтр.Дисциплина = Дисциплины[Индекс];
		ДокОтр.ВидЗанятия = ВидыЗанятий[0];
		ДокОтр.Преподаватель = Преподаватели[Индекс];
		ДокОтр.ОтработаноЧасов = 2;
		ДокОтр.ОценкаЗачет = "Зачтено";
		ДокОтр.Записать(РежимЗаписиДокумента.Проведение);

		ДокПред = Документы.ПредупреждениеОПропусках.СоздатьДокумент();
		ДокПред.Дата = Дата(2026, 10, 25, 12, Индекс, 0);
		ДокПред.Обучающийся = Обучающиеся[Индекс];
		ДокПред.Семестр = Семестры[Индекс];
		ДокПред.КоличествоНеуважительныхЧасов = 20;
		ДокПред.Ответственный = Сотрудники[Индекс];
		ДокПред.ШаблонУведомления = Шаблоны[Индекс];
		ДокПред.Комментарий = "Вынесено предупреждение деканата";
		ДокПред.Записать(РежимЗаписиДокумента.Проведение);
		ПредупрежденияСсылки.Добавить(ДокПред.Ссылка);

		ДокАкт = Документы.АктКонтроляПосещаемости.СоздатьДокумент();
		ДокАкт.Дата = Дата(2026, 10, 26, 12, Индекс, 0);
		ДокАкт.УчебнаяГруппа = Группы[Индекс];
		ДокАкт.Дисциплина = Дисциплины[Индекс];
		ДокАкт.Пара = Пары[0];
		ДокАкт.Аудитория = Аудитории[Индекс];
		ДокАкт.Проверяющий = Сотрудники[Индекс];
		ДокАкт.ВсегоПоСписку = 25;
		ДокАкт.ПрисутствовалоПоФакту = 20 + (Индекс % 5);
		ДокАкт.Замечания = "Плановая проверка деканата";
		ДокАкт.Записать(РежимЗаписиДокумента.Проведение);

		ДокЗакр = Документы.ЗакрытиеУчебногоПериода.СоздатьДокумент();
		ДокЗакр.Дата = Дата(2026, 10, 30, 16, Индекс, 0);
		ДокЗакр.Семестр = Семестры[Индекс];
		ДокЗакр.ДатаЗакрытия = Дата(2026, 10, 30);
		ДокЗакр.Ответственный = Сотрудники[Индекс];
		ДокЗакр.Комментарий = "Итоги контрольного месяца";
		ДокЗакр.Записать(РежимЗаписиДокумента.Проведение);
	КонецЦикла;

	// 12. Бизнес-процессы (по 10 экземпляров каждого)
	Для Индекс = 0 По 9 Цикл
		БП1 = БизнесПроцессы.СогласованиеОправдательногоДокумента.СоздатьБизнесПроцесс();
		БП1.Дата = Дата(2026, 10, 21, 9, Индекс, 0);
		БП1.Обучающийся = Обучающиеся[Индекс];
		БП1.ОправдательныйДокумент = СправкиСсылки[Индекс];
		БП1.ОтветственныйМетодист = Сотрудники[Индекс];
		БП1.РезультатПроверки = Перечисления.СтатусыСправки.Принята;
		БП1.Записать();
		БП1.Старт();

		БП2 = БизнесПроцессы.РеагированиеНаПревышениеПропусков.СоздатьБизнесПроцесс();
		БП2.Дата = Дата(2026, 10, 25, 14, Индекс, 0);
		БП2.Обучающийся = Обучающиеся[Индекс];
		БП2.Семестр = Семестры[Индекс];
		БП2.Куратор = Сотрудники[Индекс];
		БП2.КоличествоНеуважительныхЧасов = 20;
		БП2.ДокументПредупреждения = ПредупрежденияСсылки[Индекс];
		БП2.Записать();
		БП2.Старт();
	КонецЦикла;

	Возврат "База очищена и заново заполнена чистыми тестовыми данными (без дублей)!";

КонецФункции

&НаСервере
Функция СоздатьГруппуСправочника(ИмяСправочника, НаименованиеГруппы)
	Гр = Справочники[ИмяСправочника].СоздатьГруппу();
	Гр.Наименование = НаименованиеГруппы;
	Гр.Записать();
	Возврат Гр.Ссылка;
КонецФункции

&НаСервере
Функция СоздатьФизЛицо(ФИО, ДатаРожд, Телефон)
	Об = Справочники.ФизическиеЛица.СоздатьЭлемент();
	Об.Наименование = ФИО;
	Об.ДатаРождения = ДатаРожд;
	Об.Телефон = Телефон;
	Об.ЭлектроннаяПочта = "user_" + СтрЗаменить(Телефон, "+", "") + "@univ.ru";
	Об.Записать();
	Возврат Об.Ссылка;
КонецФункции

&НаКлиенте
Процедура ОчиститьБазу(Команда)
	Отчет = ОчиститьБазуНаСервере();
	ПоказатьПредупреждение(, Отчет);
КонецПроцедуры

&НаСервере
Функция ОчиститьБазуНаСервере()

	УстановитьПривилегированныйРежим(Истина);
	УдаленоВсего = 0;

	Для Каждого МетаОбъект Из Метаданные.Задачи Цикл
		УдаленоВсего = УдаленоВсего + УдалитьОбъектыМенеджера(Задачи[МетаОбъект.Имя], Ложь, Ложь);
	КонецЦикла;

	Для Каждого МетаОбъект Из Метаданные.БизнесПроцессы Цикл
		УдаленоВсего = УдаленоВсего + УдалитьОбъектыМенеджера(БизнесПроцессы[МетаОбъект.Имя], Ложь, Ложь);
	КонецЦикла;

	Для Каждого МетаОбъект Из Метаданные.Документы Цикл
		УдаленоВсего = УдаленоВсего + УдалитьОбъектыМенеджера(Документы[МетаОбъект.Имя], Истина, Ложь);
	КонецЦикла;

	Для Каждого МетаОбъект Из Метаданные.Справочники Цикл
		УдаленоВсего = УдаленоВсего + УдалитьОбъектыМенеджера(Справочники[МетаОбъект.Имя], Ложь, МетаОбъект.Иерархический);
	КонецЦикла;

	Возврат "База очищена. Удалено объектов: " + УдаленоВсего + ".";

КонецФункции

&НаСервере
Функция УдалитьОбъектыМенеджера(Менеджер, ЭтоДокумент, Иерархический)

	Счетчик = 0;
	Группы = Новый Массив;

	Выборка = Менеджер.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Иерархический И Выборка.ЭтоГруппа Тогда
			Группы.Добавить(Выборка.Ссылка);
			Продолжить;
		КонецЕсли;
		Об = Выборка.Ссылка.ПолучитьОбъект();
		Если Об <> Неопределено Тогда
			Если ЭтоДокумент И Об.Проведен Тогда
				Об.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			КонецЕсли;
			Об.Удалить();
			Счетчик = Счетчик + 1;
		КонецЕсли;
	КонецЦикла;

	Для Каждого СсылкаГруппы Из Группы Цикл
		ОбГр = СсылкаГруппы.ПолучитьОбъект();
		Если ОбГр <> Неопределено Тогда
			ОбГр.Удалить();
			Счетчик = Счетчик + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Счетчик;

КонецФункции