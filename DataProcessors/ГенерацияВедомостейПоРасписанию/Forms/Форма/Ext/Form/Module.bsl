&НаКлиенте
Процедура СформироватьВедомости(Команда)

	Если Не ЗначениеЗаполнено(Объект.ДатаНачала) Или Не ЗначениеЗаполнено(Объект.ДатаОкончания) Тогда
		ПоказатьПредупреждение(, "Укажите период формирования (дату начала и дату окончания).");
		Возврат;
	КонецЕсли;

	Если Объект.ДатаНачала > Объект.ДатаОкончания Тогда
		ПоказатьПредупреждение(, "Дата начала не может быть больше даты окончания.");
		Возврат;
	КонецЕсли;

	Создано = СформироватьВедомостиНаСервере();
	ПоказатьПредупреждение(, "Готово! Создано новых ведомостей посещаемости: " + Создано + ".");

КонецПроцедуры

&НаСервере
Функция СформироватьВедомостиНаСервере()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Расписание.УчебнаяГруппа КАК УчебнаяГруппа,
		|	Расписание.ДатаЗанятия КАК ДатаЗанятия,
		|	Расписание.Пара КАК Пара,
		|	Расписание.Пара.КоличествоАкадемЧасов КАК ЧасыПары,
		|	Расписание.Дисциплина КАК Дисциплина,
		|	Расписание.Преподаватель КАК Преподаватель,
		|	Расписание.ВидЗанятия КАК ВидЗанятия,
		|	Расписание.Аудитория КАК Аудитория
		|ИЗ
		|	РегистрСведений.РасписаниеЗанятий.СрезПоследних(,
		|		ДатаЗанятия МЕЖДУ &ДатаНач И &ДатаКон
		|		И Отменено = ЛОЖЬ) КАК Расписание
		|ГДЕ
		|	(&ГруппаПустая ИЛИ Расписание.УчебнаяГруппа = &УчебнаяГруппа)
		|УПОРЯДОЧИТЬ ПО
		|	Расписание.ДатаЗанятия,
		|	Расписание.Пара.НомерПары";

	Запрос.УстановитьПараметр("ДатаНач", НачалоДня(Объект.ДатаНачала));
	Запрос.УстановитьПараметр("ДатаКон", НачалоДня(Объект.ДатаОкончания));
	Запрос.УстановитьПараметр("ГруппаПустая", Не ЗначениеЗаполнено(Объект.УчебнаяГруппа));
	Запрос.УстановитьПараметр("УчебнаяГруппа", Объект.УчебнаяГруппа);

	Выборка = Запрос.Выполнить().Выбрать();
	СчетчикСозданных = 0;

	Пока Выборка.Следующий() Цикл
		// Проверяем, не создана ли уже ведомость на эту группу, дату и пару
		Если ВедомостьУжеСуществует(Выборка.УчебнаяГруппа, Выборка.ДатаЗанятия, Выборка.Пара) Тогда
			Продолжить;
		КонецЕсли;

		НовыйДок = Документы.ВедомостьПосещаемостиЗанятия.СоздатьДокумент();
		НовыйДок.Дата = Выборка.ДатаЗанятия;
		НовыйДок.УчебнаяГруппа = Выборка.УчебнаяГруппа;
		НовыйДок.Дисциплина = Выборка.Дисциплина;
		НовыйДок.Преподаватель = Выборка.Преподаватель;
		НовыйДок.ВидЗанятия = Выборка.ВидЗанятия;
		НовыйДок.Пара = Выборка.Пара;
		НовыйДок.Аудитория = Выборка.Аудитория;
		НовыйДок.КоличествоЧасов = ?(Выборка.ЧасыПары > 0, Выборка.ЧасыПары, 2);

		// Автоматически заполняем список активных студентов группы через общий модуль
		СтудентыГруппы = УчетПосещаемостиСервер.ПолучитьАктивныхОбучающихсяГруппы(
			Выборка.УчебнаяГруппа, Выборка.ДатаЗанятия);

		Для Каждого Студент Из СтудентыГруппы Цикл
			НоваяСтрока = НовыйДок.Посещаемость.Добавить();
			НоваяСтрока.Обучающийся = Студент;
			НоваяСтрока.Статус = Перечисления.СтатусыПосещаемости.Присутствовал;
		КонецЦикла;

		НовыйДок.Записать(РежимЗаписиДокумента.Запись);
		СчетчикСозданных = СчетчикСозданных + 1;
	КонецЦикла;

	Возврат СчетчикСозданных;

КонецФункции

&НаСервере
Функция ВедомостьУжеСуществует(УчебнаяГруппа, ДатаЗанятия, Пара)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Ведомость.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ВедомостьПосещаемостиЗанятия КАК Ведомость
		|ГДЕ
		|	Ведомость.УчебнаяГруппа = &УчебнаяГруппа
		|	И Ведомость.Пара = &Пара
		|	И Ведомость.Дата МЕЖДУ &НачалоДня И &КонецДня
		|	И НЕ Ведомость.ПометкаУдаления";

	Запрос.УстановитьПараметр("УчебнаяГруппа", УчебнаяГруппа);
	Запрос.УстановитьПараметр("Пара", Пара);
	Запрос.УстановитьПараметр("НачалоДня", НачалоДня(ДатаЗанятия));
	Запрос.УстановитьПараметр("КонецДня", КонецДня(ДатаЗанятия));

	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции