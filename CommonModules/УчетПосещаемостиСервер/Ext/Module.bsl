// Возвращает массив ссылок на обучающихся со статусом "Обучается" в группе на указанную дату
Функция ПолучитьАктивныхОбучающихсяГруппы(УчебнаяГруппа, ДатаСреза) Экспорт

	Результат = Новый Массив;
	Если Не ЗначениеЗаполнено(УчебнаяГруппа) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Состояния.Обучающийся КАК Обучающийся
		|ИЗ
		|	РегистрСведений.СостояниеОбучающихся.СрезПоследних(&ДатаСреза,
		|		УчебнаяГруппа = &УчебнаяГруппа
		|		И Статус = &СтатусОбучается) КАК Состояния
		|УПОРЯДОЧИТЬ ПО
		|	Состояния.Обучающийся.Наименование";

	Запрос.УстановитьПараметр("ДатаСреза", КонецДня(ДатаСреза));
	Запрос.УстановитьПараметр("УчебнаяГруппа", УчебнаяГруппа);
	Запрос.УстановитьПараметр("СтатусОбучается", Перечисления.СтатусыОбучающегося.Обучается);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.Обучающийся);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Рассчитывает сводные показатели посещаемости обучающегося за период
Функция РассчитатьПоказателиПосещаемости(Обучающийся, ДатаНачала, ДатаОкончания) Экспорт

	Итоги = Новый Структура;
	Итоги.Вставить("ЧасыПосещено", 0);
	Итоги.Вставить("ЧасыПропущено", 0);
	Итоги.Вставить("ЧасыОпозданий", 0);
	Итоги.Вставить("ПроцентПосещаемости", 0);

	Если Не ЗначениеЗаполнено(Обучающийся) Тогда
		Возврат Итоги;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(Обороты.ЧасыПосещеноОборот), 0) КАК ЧасыПосещено,
		|	ЕСТЬNULL(СУММА(Обороты.ЧасыПропущеноВсегоОборот), 0) КАК ЧасыПропущено,
		|	ЕСТЬNULL(СУММА(Обороты.ЧасыОпозданийОборот), 0) КАК ЧасыОпозданий
		|ИЗ
		|	РегистрНакопления.ПосещаемостьОбучающихся.Обороты(&ДатаНач, &ДатаКон, ,
		|		Обучающийся = &Обучающийся) КАК Обороты";

	Запрос.УстановитьПараметр("ДатаНач", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("ДатаКон", КонецДня(ДатаОкончания));
	Запрос.УстановитьПараметр("Обучающийся", Обучающийся);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Итоги.ЧасыПосещено = Выборка.ЧасыПосещено;
		Итоги.ЧасыПропущено = Выборка.ЧасыПропущено;
		Итоги.ЧасыОпозданий = Выборка.ЧасыОпозданий;

		ВсегоЧасов = Выборка.ЧасыПосещено + Выборка.ЧасыПропущено + Выборка.ЧасыОпозданий;
		Если ВсегоЧасов > 0 Тогда
			Итоги.ПроцентПосещаемости = Окр((Выборка.ЧасыПосещено / ВсегоЧасов) * 100, 2);
		КонецЕсли;
	КонецЕсли;

	Возврат Итоги;

КонецФункции

// Проверяет превышение порога неуважительных пропусков обучающегося за период
Функция ПроверитьПорогПропусков(Обучающийся, ДатаНачала, ДатаОкончания) Экспорт

	Результат = Новый Структура("НеуважительныхЧасов, ПорогЧасов, ПревышенПорог", 0, 0, Ложь);
	Порог = Константы.ПорогНеуважительныхПропусковВЧасах.Получить();
	Результат.ПорогЧасов = Порог;

	Если Не ЗначениеЗаполнено(Обучающийся) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(Пропуски.ЧасыПропусковОборот), 0) КАК НеуважительныхЧасов
		|ИЗ
		|	РегистрНакопления.ПропускиПоПричинам.Обороты(&ДатаНач, &ДатаКон, ,
		|		Обучающийся = &Обучающийся И Уважительная = ЛОЖЬ) КАК Пропуски";

	Запрос.УстановитьПараметр("ДатаНач", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("ДатаКон", КонецДня(ДатаОкончания));
	Запрос.УстановитьПараметр("Обучающийся", Обучающийся);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.НеуважительныхЧасов = Выборка.НеуважительныхЧасов;
		Если Порог > 0 И Выборка.НеуважительныхЧасов >= Порог Тогда
			Результат.ПревышенПорог = Истина;
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Формирует готовый текст уведомления на основе справочника ШаблоныУведомлений
Функция СформироватьТекстУведомления(Обучающийся, КоличествоЧасов, ШаблонУведомления) Экспорт

	Если Не ЗначениеЗаполнено(ШаблонУведомления) Тогда
		Возврат "";
	КонецЕсли;

	Текст = ШаблонУведомления.ТекстШаблона;
	Вуз = Константы.НаименованиеУчебногоЗаведения.Получить();
	Порог = Константы.ПорогНеуважительныхПропусковВЧасах.Получить();

	Текст = СтрЗаменить(Текст, "[ФИО]", Строка(Обучающийся));
	Текст = СтрЗаменить(Текст, "[Группа]", Строка(Обучающийся.УчебнаяГруппа));
	Текст = СтрЗаменить(Текст, "[Часы]", Строка(КоличествоЧасов));
	Текст = СтрЗаменить(Текст, "[Порог]", Строка(Порог));
	Текст = СтрЗаменить(Текст, "[Вуз]", Вуз);

	Возврат Текст;

КонецФункции

// Проверяет, закрыт ли учебный период для указанной даты документом ЗакрытиеУчебногоПериода
Функция ПериодЗакрытДляРедактирования(ПроверяемаяДата) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Закрытие.ДатаЗакрытия КАК ДатаЗакрытия
		|ИЗ
		|	Документ.ЗакрытиеУчебногоПериода КАК Закрытие
		|ГДЕ
		|	Закрытие.Проведен = ИСТИНА
		|	И Закрытие.ДатаЗакрытия >= &ПроверяемаяДата";

	Запрос.УстановитьПараметр("ПроверяемаяДата", НачалоДня(ПроверяемаяДата));
	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции