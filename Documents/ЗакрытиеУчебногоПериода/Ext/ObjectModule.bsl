Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если Не ЗначениеЗаполнено(Семестр) Или Не ЗначениеЗаполнено(ДатаЗакрытия) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Укажите семестр и дату закрытия учебного периода.";
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	СУММА(Обороты.ЧасыПосещеноОборот) КАК Посещено,
		|	СУММА(Обороты.ЧасыПропущеноВсегоОборот) КАК Пропущено
		|ИЗ
		|	РегистрНакопления.ПосещаемостьОбучающихся.Обороты(&ДатаНач, &ДатаКон) КАК Обороты";
	Запрос.УстановитьПараметр("ДатаНач", НачалоДня(Семестр.ДатаНачала));
	Запрос.УстановитьПараметр("ДатаКон", КонецДня(ДатаЗакрытия));

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ВсегоЧасов = Выборка.Посещено + Выборка.Пропущено;
		Если ВсегоЧасов > 0 Тогда
			ИтогПосещаемостиПроцент = Окр((Выборка.Посещено / ВсегоЧасов) * 100, 2);
		Иначе
			ИтогПосещаемостиПроцент = 0;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры