        Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если Не ЗначениеЗаполнено(УчебнаяГруппа) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не указана учебная группа для зачисления.";
		Сообщение.Поле = "УчебнаяГруппа";
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;

	Если Обучающиеся.Количество() = 0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Табличная часть ""Обучающиеся"" не заполнена.";
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;

	ПроверенныеСтуденты = Новый Соответствие;
	Для Каждого СтрокаТЧ Из Обучающиеся Цикл
		Если Не ЗначениеЗаполнено(СтрокаТЧ.Обучающийся) Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "В строке №" + СтрокаТЧ.НомерСтроки + " не выбран обучающийся.";
			Сообщение.Сообщить();
			Отказ = Истина;
			Продолжить;
		КонецЕсли;
		Если ПроверенныеСтуденты.Получить(СтрокаТЧ.Обучающийся) <> Неопределено Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Обучающийся """ + СтрокаТЧ.Обучающийся + """ указан в документе повторно.";
			Сообщение.Сообщить();
			Отказ = Истина;
		Иначе
			ПроверенныеСтуденты.Вставить(СтрокаТЧ.Обучающийся, Истина);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	Движения.СостояниеОбучающихся.Записывать = Истина;

	Для Каждого СтрокаТЧ Из Обучающиеся Цикл
		Движение = Движения.СостояниеОбучающихся.Добавить();
		Движение.Период = Дата;
		Движение.Обучающийся = СтрокаТЧ.Обучающийся;
		Движение.УчебнаяГруппа = УчебнаяГруппа;
		Движение.Статус = Перечисления.СтатусыОбучающегося.Обучается;
	КонецЦикла;

КонецПроцедуры