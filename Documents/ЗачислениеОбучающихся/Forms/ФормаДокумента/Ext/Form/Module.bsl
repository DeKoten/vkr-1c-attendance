&НаКлиенте
Процедура ПечатьПриказа(Команда)
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПоказатьПредупреждение(, "Сначала запишите документ перед печатью.");
		Возврат;
	КонецЕсли;
	ТабДок = СформироватьПриказНаСервере();
	ТабДок.ТолькоПросмотр = Истина;
	ТабДок.Показать("Приказ о зачислении");
КонецПроцедуры

&НаСервере
Функция СформироватьПриказНаСервере()

	ТабДок = Новый ТабличныйДокумент;
	Рамка = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);

	ТабДок.Область(1, 1).Текст = Константы.НаименованиеУчебногоЗаведения.Получить();
	ТабДок.Область(1, 1).Шрифт = Новый Шрифт("Arial", 10, Истина);

	ТабДок.Область(3, 1).Текст = "ПРИКАЗ О ЗАЧИСЛЕНИИ № " + Объект.НомерПриказа + " от " + Формат(Объект.Дата, "ДФ=dd.MM.yyyy");
	ТабДок.Область(3, 1).Шрифт = Новый Шрифт("Arial", 12, Истина);

	ТабДок.Область(5, 1).Текст = "Учебная группа: " + Строка(Объект.УчебнаяГруппа);
	ТабДок.Область(6, 1).Текст = "Примечание: " + Объект.Комментарий;

	ТабДок.Область(8, 1).Текст = "№";
	ТабДок.Область(8, 2).Текст = "Обучающийся";
	ТабДок.Область(8, 3).Текст = "Номер студ. билета";
	Для Индекс = 1 По 3 Цикл
		Ячейка = ТабДок.Область(8, Индекс);
		Ячейка.Шрифт = Новый Шрифт("Arial", 10, Истина);
		Ячейка.ГраницаСверху = Рамка;
		Ячейка.ГраницаСнизу = Рамка;
		Ячейка.ГраницаСлева = Рамка;
		Ячейка.ГраницаСправа = Рамка;
	КонецЦикла;

	НомерСтр = 9;
	Для Каждого СтрокаТЧ Из Объект.Обучающиеся Цикл
		ТабДок.Область(НомерСтр, 1).Текст = Строка(СтрокаТЧ.НомерСтроки);
		ТабДок.Область(НомерСтр, 2).Текст = Строка(СтрокаТЧ.Обучающийся);
		ТабДок.Область(НомерСтр, 3).Текст = СтрокаТЧ.НомерСтудБилета;
		Для Индекс = 1 По 3 Цикл
			Ячейка = ТабДок.Область(НомерСтр, Индекс);
			Ячейка.ГраницаСверху = Рамка;
			Ячейка.ГраницаСнизу = Рамка;
			Ячейка.ГраницаСлева = Рамка;
			Ячейка.ГраницаСправа = Рамка;
		КонецЦикла;
		НомерСтр = НомерСтр + 1;
	КонецЦикла;

	ТабДок.Область(НомерСтр + 2, 1).Текст = "Ответственный: " + Строка(Объект.Ответственный) + "   Подпись: ____________";
	ТабДок.Область("C1").ШиринаКолонки = 6;
	ТабДок.Область("C2").ШиринаКолонки = 35;
	ТабДок.Область("C3").ШиринаКолонки = 25;
	ТабДок.АвтоМасштаб = Истина;

	Возврат ТабДок;

КонецФункции