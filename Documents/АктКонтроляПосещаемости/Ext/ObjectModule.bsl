Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если Не ЗначениеЗаполнено(УчебнаяГруппа) Или Не ЗначениеЗаполнено(Проверяющий) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Укажите учебную группу и проверяющего сотрудника деканата.";
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;

	Если ВсегоПоСписку <= 0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Количество обучающихся по списку должно быть больше нуля.";
		Сообщение.Поле = "ВсегоПоСписку";
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;

	Если ПрисутствовалоПоФакту > ВсегоПоСписку Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Число присутствующих по факту не может превышать численность группы по списку.";
		Сообщение.Поле = "ПрисутствовалоПоФакту";
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры