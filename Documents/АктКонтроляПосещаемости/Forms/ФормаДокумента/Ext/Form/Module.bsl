&НаКлиенте
Процедура ПечатьАкта(Команда)
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПоказатьПредупреждение(, "Сначала запишите документ перед выводом на печать.");
		Возврат;
	КонецЕсли;
	ТабДок = СформироватьАктНаСервере();
	ТабДок.ТолькоПросмотр = Истина;
	ТабДок.Показать("Акт контроля посещаемости");
КонецПроцедуры

&НаСервере
Функция СформироватьАктНаСервере()

	ТабДок = Новый ТабличныйДокумент;
	Рамка = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);

	Вуз = Константы.НаименованиеУчебногоЗаведения.Получить();
	ТабДок.Область(1, 1).Текст = Вуз;
	ТабДок.Область(1, 1).Шрифт = Новый Шрифт("Arial", 10, Истина);

	ТабДок.Область(3, 1).Текст = "АКТ КОНТРОЛЯ ПОСЕЩАЕМОСТИ № " + Объект.Номер + " от " + Формат(Объект.Дата, "ДФ=dd.MM.yyyy");
	ТабДок.Область(3, 1).Шрифт = Новый Шрифт("Arial", 12, Истина);

	ПроцентЯвки = 0;
	Если Объект.ВсегоПоСписку > 0 Тогда
		ПроцентЯвки = Окр((Объект.ПрисутствовалоПоФакту / Объект.ВсегоПоСписку) * 100, 1);
	КонецЕсли;

	СтрокиТаб = Новый Массив;
	СтрокиТаб.Добавить(Новый Структура("Поле, Значение", "Учебная группа", Строка(Объект.УчебнаяГруппа)));
	СтрокиТаб.Добавить(Новый Структура("Поле, Значение", "Дисциплина", Строка(Объект.Дисциплина)));
	СтрокиТаб.Добавить(Новый Структура("Поле, Значение", "Пара и аудитория", Строка(Объект.Пара) + ", " + Строка(Объект.Аудитория)));
	СтрокиТаб.Добавить(Новый Структура("Поле, Значение", "Всего по списку (чел.)", Строка(Объект.ВсегоПоСписку)));
	СтрокиТаб.Добавить(Новый Структура("Поле, Значение", "Присутствовало по факту (чел.)", Строка(Объект.ПрисутствовалоПоФакту)));
	СтрокиТаб.Добавить(Новый Структура("Поле, Значение", "Процент фактической явки", Строка(ПроцентЯвки) + " %"));
	СтрокиТаб.Добавить(Новый Структура("Поле, Значение", "Замечания", Объект.Замечания));

	НомерСтроки = 5;
	Для Каждого Элем Из СтрокиТаб Цикл
		Ячейка1 = ТабДок.Область(НомерСтроки, 1);
		Ячейка1.Текст = Элем.Поле;
		Ячейка1.Шрифт = Новый Шрифт("Arial", 10, Истина);
		Ячейка1.ГраницаСверху = Рамка;
		Ячейка1.ГраницаСнизу = Рамка;
		Ячейка1.ГраницаСлева = Рамка;
		Ячейка1.ГраницаСправа = Рамка;

		Ячейка2 = ТабДок.Область(НомерСтроки, 2);
		Ячейка2.Текст = Элем.Значение;
		Ячейка2.ГраницаСверху = Рамка;
		Ячейка2.ГраницаСнизу = Рамка;
		Ячейка2.ГраницаСлева = Рамка;
		Ячейка2.ГраницаСправа = Рамка;

		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;

	ТабДок.Область(НомерСтроки + 2, 1).Текст = "Проверяющий: " + Строка(Объект.Проверяющий);
	ТабДок.Область(НомерСтроки + 2, 2).Текст = "Подпись: ___________________";

	ТабДок.Область("C1").ШиринаКолонки = 32;
	ТабДок.Область("C2").ШиринаКолонки = 50;
	ТабДок.АвтоМасштаб = Истина;

	Возврат ТабДок;

КонецФункции