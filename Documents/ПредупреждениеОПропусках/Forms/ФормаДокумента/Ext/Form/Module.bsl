&НаКлиенте
Процедура ПечатьУведомления(Команда)
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПоказатьПредупреждение(, "Сначала запишите документ перед печатью.");
		Возврат;
	КонецЕсли;
	ТабДок = СформироватьУведомлениеНаСервере();
	ТабДок.ТолькоПросмотр = Истина;
	ТабДок.Показать("Уведомление о пропусках занятий");
КонецПроцедуры

&НаСервере
Функция СформироватьУведомлениеНаСервере()

	ТабДок = Новый ТабличныйДокумент;

	Вуз = Константы.НаименованиеУчебногоЗаведения.Получить();
	ТабДок.Область(1, 1).Текст = Вуз;
	ТабДок.Область(1, 1).Шрифт = Новый Шрифт("Arial", 10, Истина);

	ТабДок.Область(3, 1).Текст = "УВЕДОМЛЕНИЕ О ПРЕВЫШЕНИИ ПОРОГА ПРОПУСКОВ № " + Объект.Номер + " от " + Формат(Объект.Дата, "ДФ=dd.MM.yyyy");
	ТабДок.Область(3, 1).Шрифт = Новый Шрифт("Arial", 12, Истина);

	ТекстПисьма = УчетПосещаемостиСервер.СформироватьТекстУведомления(
		Объект.Обучающийся, Объект.КоличествоНеуважительныхЧасов, Объект.ШаблонУведомления);

	Если ПустаяСтрока(ТекстПисьма) Тогда
		ТекстПисьма = "Обучающемуся " + Строка(Объект.Обучающийся)
			+ " вынесено предупреждение за " + Объект.КоличествоНеуважительныхЧасов + " ч. неуважительных пропусков.";
	КонецЕсли;

	ЯчейкаТекста = ТабДок.Область(5, 1);
	ЯчейкаТекста.Текст = ТекстПисьма;
	ЯчейкаТекста.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;

	ТабДок.Область(7, 1).Текст = "Семестр: " + Строка(Объект.Семестр);
	ТабДок.Область(8, 1).Текст = "Комментарий деканата: " + Объект.Комментарий;
	ТабДок.Область(10, 1).Текст = "Ответственный сотрудник: " + Строка(Объект.Ответственный) + "   Подпись: ____________";
	ТабДок.Область(11, 1).Текст = "Ознакомлен (обучающийся): " + Строка(Объект.Обучающийся) + "   Подпись: ____________";

	ТабДок.Область("C1").ШиринаКолонки = 85;
	ТабДок.АвтоМасштаб = Истина;

	Возврат ТабДок;

КонецФункции