Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если Не ЗначениеЗаполнено(Обучающийся) Или Не ЗначениеЗаполнено(Семестр) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Укажите обучающегося и семестр.";
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;

	Порог = Константы.ПорогНеуважительныхПропусковВЧасах.Получить();
	Если Порог > 0 И КоличествоНеуважительныхЧасов < Порог Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Количество неуважительных часов (" + КоличествоНеуважительныхЧасов
			+ ") меньше установленного порога (" + Порог + " ч.).";
		Сообщение.Поле = "КоличествоНеуважительныхЧасов";
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	Движения.ДисциплинарныеМеры.Записывать = Истина;

	Движение = Движения.ДисциплинарныеМеры.Добавить();
	Движение.Период = Дата;
	Движение.Обучающийся = Обучающийся;
	Движение.Семестр = Семестр;
	Движение.КоличествоНеуважительныхЧасов = КоличествоНеуважительныхЧасов;
	Движение.ОтветственныйСотрудник = Ответственный;
	Движение.Комментарий = Комментарий;

КонецПроцедуры