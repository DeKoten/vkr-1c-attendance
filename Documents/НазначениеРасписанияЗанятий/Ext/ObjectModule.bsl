Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если Не ЗначениеЗаполнено(УчебнаяГруппа) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не указана учебная группа для расписания.";
		Сообщение.Поле = "УчебнаяГруппа";
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;

	Если Занятия.Количество() = 0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Добавьте хотя бы одно занятие в расписание.";
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;

	ПроверенныеСлоты = Новый Соответствие;
	Для Каждого СтрокаТЧ Из Занятия Цикл
		Если Не ЗначениеЗаполнено(СтрокаТЧ.ДатаЗанятия) Или Не ЗначениеЗаполнено(СтрокаТЧ.Пара) Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "В строке №" + СтрокаТЧ.НомерСтроки + " не заполнена дата или номер пары.";
			Сообщение.Сообщить();
			Отказ = Истина;
			Продолжить;
		КонецЕсли;
		КлючСлота = Формат(СтрокаТЧ.ДатаЗанятия, "ДФ=yyyyMMdd") + "_" + Строка(СтрокаТЧ.Пара);
		Если ПроверенныеСлоты.Получить(КлючСлота) <> Неопределено Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "В строке №" + СтрокаТЧ.НомерСтроки + " дублируется дата и пара.";
			Сообщение.Сообщить();
			Отказ = Истина;
		Иначе
			ПроверенныеСлоты.Вставить(КлючСлота, Истина);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	Движения.РасписаниеЗанятий.Записывать = Истина;

	Для Каждого СтрокаТЧ Из Занятия Цикл
		Движение = Движения.РасписаниеЗанятий.Добавить();
		Движение.Период = Дата;
		Движение.УчебнаяГруппа = УчебнаяГруппа;
		Движение.ДатаЗанятия = НачалоДня(СтрокаТЧ.ДатаЗанятия);
		Движение.Пара = СтрокаТЧ.Пара;
		Движение.Дисциплина = СтрокаТЧ.Дисциплина;
		Движение.Преподаватель = СтрокаТЧ.Преподаватель;
		Движение.ВидЗанятия = СтрокаТЧ.ВидЗанятия;
		Движение.Аудитория = СтрокаТЧ.Аудитория;
		Движение.Отменено = Ложь;
	КонецЦикла;

КонецПроцедуры