Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если Не ЗначениеЗаполнено(Обучающийся) Или Не ЗначениеЗаполнено(Дисциплина)
		Или Не ЗначениеЗаполнено(ВидЗанятия) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Укажите обучающегося, дисциплину и вид занятия.";
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;

	Если ОтработаноЧасов <= 0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Количество отработанных часов должно быть больше нуля.";
		Сообщение.Поле = "ОтработаноЧасов";
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	// Проверка текущего остатка часов к отработке
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЕСТЬNULL(Остатки.ЧасыКОтработкеОстаток, 0) КАК ОстатокЧасов
		|ИЗ
		|	РегистрНакопления.ОтработкаПропусков.Остатки(&МоментВремени,
		|		Обучающийся = &Обучающийся
		|		И Дисциплина = &Дисциплина
		|		И ВидЗанятия = &ВидЗанятия) КАК Остатки";
	Запрос.УстановитьПараметр("МоментВремени", МоментВремени());
	Запрос.УстановитьПараметр("Обучающийся", Обучающийся);
	Запрос.УстановитьПараметр("Дисциплина", Дисциплина);
	Запрос.УстановитьПараметр("ВидЗанятия", ВидЗанятия);

	Выборка = Запрос.Выполнить().Выбрать();
	Остаток = 0;
	Если Выборка.Следующий() Тогда
		Остаток = Выборка.ОстатокЧасов;
	КонецЕсли;

	Если ОтработаноЧасов > Остаток Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Нельзя списать " + ОтработаноЧасов + " ч.: текущий долг к отработке составляет " + Остаток + " ч.";
		Сообщение.Сообщить();
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Движения.ОтработкаПропусков.Записывать = Истина;
	Движение = Движения.ОтработкаПропусков.Добавить();
	Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
	Движение.Период = Дата;
	Движение.Обучающийся = Обучающийся;
	Движение.Дисциплина = Дисциплина;
	Движение.ВидЗанятия = ВидЗанятия;
	Движение.ЧасыКОтработке = ОтработаноЧасов;

КонецПроцедуры