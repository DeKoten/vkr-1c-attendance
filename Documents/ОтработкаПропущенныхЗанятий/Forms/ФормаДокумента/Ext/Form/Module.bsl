&НаКлиенте
Процедура ПечатьЛистаОтработки(Команда)
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПоказатьПредупреждение(, "Сначала запишите документ перед печатью.");
		Возврат;
	КонецЕсли;
	ТабДок = СформироватьЛистНаСервере();
	ТабДок.ТолькоПросмотр = Истина;
	ТабДок.Показать("Лист отработки пропущенного занятия");
КонецПроцедуры

&НаСервере
Функция СформироватьЛистНаСервере()

	ТабДок = Новый ТабличныйДокумент;
	Рамка = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);

	ТабДок.Область(1, 1).Текст = Константы.НаименованиеУчебногоЗаведения.Получить();
	ТабДок.Область(1, 1).Шрифт = Новый Шрифт("Arial", 10, Истина);

	ТабДок.Область(3, 1).Текст = "ЛИСТ ОТРАБОТКИ ПРОПУЩЕННОГО ЗАНЯТИЯ № " + Объект.Номер + " от " + Формат(Объект.Дата, "ДФ=dd.MM.yyyy");
	ТабДок.Область(3, 1).Шрифт = Новый Шрифт("Arial", 12, Истина);

	Поля = Новый Массив;
	Поля.Добавить(Новый Структура("Имя, Знач", "Обучающийся", Строка(Объект.Обучающийся)));
	Поля.Добавить(Новый Структура("Имя, Знач", "Дисциплина", Строка(Объект.Дисциплина)));
	Поля.Добавить(Новый Структура("Имя, Знач", "Вид занятия", Строка(Объект.ВидЗанятия)));
	Поля.Добавить(Новый Структура("Имя, Знач", "Отработано часов", Строка(Объект.ОтработаноЧасов)));
	Поля.Добавить(Новый Структура("Имя, Знач", "Оценка / зачет", Объект.ОценкаЗачет));

	Стр = 5;
	Для Каждого Элем Из Поля Цикл
		Яч1 = ТабДок.Область(Стр, 1);
		Яч1.Текст = Элем.Имя;
		Яч1.Шрифт = Новый Шрифт("Arial", 10, Истина);
		Яч1.ГраницаСверху = Рамка;
		Яч1.ГраницаСнизу = Рамка;
		Яч1.ГраницаСлева = Рамка;
		Яч1.ГраницаСправа = Рамка;

		Яч2 = ТабДок.Область(Стр, 2);
		Яч2.Текст = Элем.Знач;
		Яч2.ГраницаСверху = Рамка;
		Яч2.ГраницаСнизу = Рамка;
		Яч2.ГраницаСлева = Рамка;
		Яч2.ГраницаСправа = Рамка;
		Стр = Стр + 1;
	КонецЦикла;

	ТабДок.Область(Стр + 2, 1).Текст = "Принял преподаватель: " + Строка(Объект.Преподаватель) + "   Подпись: ____________";
	ТабДок.Область("C1").ШиринаКолонки = 26;
	ТабДок.Область("C2").ШиринаКолонки = 46;
	ТабДок.АвтоМасштаб = Истина;

	Возврат ТабДок;

КонецФункции