Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если Не ЗначениеЗаполнено(Обучающийся) Или Не ЗначениеЗаполнено(ТипДокумента)
		Или Не ЗначениеЗаполнено(ПричинаПропуска) Или Не ЗначениеЗаполнено(СтатусСправки) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Заполните обучающегося, тип документа, причину пропуска и статус справки.";
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДатаНачала) Или Не ЗначениеЗаполнено(ДатаОкончания) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Укажите период действия оправдательного документа.";
		Сообщение.Сообщить();
		Отказ = Истина;
	ИначеЕсли ДатаНачала > ДатаОкончания Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Дата начала справки не может быть позже даты окончания.";
		Сообщение.Поле = "ДатаНачала";
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;

	Если СтатусСправки = Перечисления.СтатусыСправки.Принята
		И ЗначениеЗаполнено(ПричинаПропуска)
		И Не ПричинаПропуска.Уважительная Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Для принятого оправдательного документа причина пропуска должна быть уважительной.";
		Сообщение.Поле = "ПричинаПропуска";
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	Движения.ОправдательныеДокументы.Записывать = Истина;
	Движения.ПропускиПоПричинам.Записывать = Истина;

	// 1. Запись в регистр сведений ОправдательныеДокументы
	ДвижСпр = Движения.ОправдательныеДокументы.Добавить();
	ДвижСпр.Период = Дата;
	ДвижСпр.Обучающийся = Обучающийся;
	ДвижСпр.ДатаНачала = НачалоДня(ДатаНачала);
	ДвижСпр.ДатаОкончания = НачалоДня(ДатаОкончания);
	ДвижСпр.ТипДокумента = ТипДокумента;
	ДвижСпр.ПричинаПропуска = ПричинаПропуска;
	ДвижСпр.СтатусСправки = СтатусСправки;
	ДвижСпр.НомерСправки = НомерСправки;

	// 2. Если справка принята — переквалифицируем неуважительные пропуски за период в уважительные
	Если СтатусСправки = Перечисления.СтатусыСправки.Принята Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Пропуски.УчебнаяГруппа КАК УчебнаяГруппа,
			|	Пропуски.Дисциплина КАК Дисциплина,
			|	Пропуски.ПричинаПропуска КАК ПричинаПропуска,
			|	СУММА(Пропуски.ЧасыПропусков) КАК ЧасыПропусков
			|ИЗ
			|	РегистрНакопления.ПропускиПоПричинам КАК Пропуски
			|ГДЕ
			|	Пропуски.Обучающийся = &Обучающийся
			|	И Пропуски.Уважительная = ЛОЖЬ
			|	И Пропуски.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
			|	И Пропуски.Регистратор <> &ТекущийДокумент
			|
			|СГРУППИРОВАТЬ ПО
			|	Пропуски.УчебнаяГруппа,
			|	Пропуски.Дисциплина,
			|	Пропуски.ПричинаПропуска
			|
			|ИМЕЮЩИЕ
			|	СУММА(Пропуски.ЧасыПропусков) > 0";

		Запрос.УстановитьПараметр("Обучающийся", Обучающийся);
		Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачала));
		Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));
		Запрос.УстановитьПараметр("ТекущийДокумент", Ссылка);

		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			// Сторно неуважительных часов
			Сторно = Движения.ПропускиПоПричинам.Добавить();
			Сторно.Период = Дата;
			Сторно.Обучающийся = Обучающийся;
			Сторно.УчебнаяГруппа = Выборка.УчебнаяГруппа;
			Сторно.Дисциплина = Выборка.Дисциплина;
			Сторно.ПричинаПропуска = Выборка.ПричинаПропуска;
			Сторно.Уважительная = Ложь;
			Сторно.ЧасыПропусков = -Выборка.ЧасыПропусков;

			// Перенос в уважительные часы по причине из справки
			НовЗапись = Движения.ПропускиПоПричинам.Добавить();
			НовЗапись.Период = Дата;
			НовЗапись.Обучающийся = Обучающийся;
			НовЗапись.УчебнаяГруппа = Выборка.УчебнаяГруппа;
			НовЗапись.Дисциплина = Выборка.Дисциплина;
			НовЗапись.ПричинаПропуска = ПричинаПропуска;
			НовЗапись.Уважительная = Истина;
			НовЗапись.ЧасыПропусков = Выборка.ЧасыПропусков;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры