&НаКлиенте
Процедура ПечатьСправки(Команда)
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПоказатьПредупреждение(, "Сначала запишите документ перед выводом на печать.");
		Возврат;
	КонецЕсли;
	ТабДок = СформироватьСправкуНаСервере();
	ТабДок.ТолькоПросмотр = Истина;
	ТабДок.Показать("Карточка оправдательного документа");
КонецПроцедуры

&НаСервере
Функция СформироватьСправкуНаСервере()

	ТабДок = Новый ТабличныйДокумент;
	Рамка = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);

	ТабДок.Область(1, 1).Текст = Константы.НаименованиеУчебногоЗаведения.Получить();
	ТабДок.Область(1, 1).Шрифт = Новый Шрифт("Arial", 10, Истина);

	ТабДок.Область(3, 1).Текст = "КАРТОЧКА ОПРАВДАТЕЛЬНОГО ДОКУМЕНТА № " + Объект.НомерСправки;
	ТабДок.Область(3, 1).Шрифт = Новый Шрифт("Arial", 12, Истина);

	Поля = Новый Массив;
	Поля.Добавить(Новый Структура("Имя, Знач", "Обучающийся", Строка(Объект.Обучающийся)));
	Поля.Добавить(Новый Структура("Имя, Знач", "Тип документа", Строка(Объект.ТипДокумента)));
	Поля.Добавить(Новый Структура("Имя, Знач", "Причина пропуска", Строка(Объект.ПричинаПропуска)));
	Поля.Добавить(Новый Структура("Имя, Знач", "Период освобождения", Формат(Объект.ДатаНачала, "ДФ=dd.MM.yyyy") + " — " + Формат(Объект.ДатаОкончания, "ДФ=dd.MM.yyyy")));
	Поля.Добавить(Новый Структура("Имя, Знач", "Статус проверки", Строка(Объект.СтатусСправки)));
	Поля.Добавить(Новый Структура("Имя, Знач", "Дата регистрации", Формат(Объект.Дата, "ДФ=dd.MM.yyyy")));

	Стр = 5;
	Для Каждого Элем Из Поля Цикл
		Яч1 = ТабДок.Область(Стр, 1);
		Яч1.Текст = Элем.Имя;
		Яч1.Шрифт = Новый Шрифт("Arial", 10, Истина);
		Яч1.ГраницаСверху = Рамка;
		Яч1.ГраницаСнизу = Рамка;
		Яч1.ГраницаСлева = Рамка;
		Яч1.ГраницаСправа = Рамка;

		Яч2 = ТабДок.Область(Стр, 2);
		Яч2.Текст = Элем.Знач;
		Яч2.ГраницаСверху = Рамка;
		Яч2.ГраницаСнизу = Рамка;
		Яч2.ГраницаСлева = Рамка;
		Яч2.ГраницаСправа = Рамка;
		Стр = Стр + 1;
	КонецЦикла;

	ТабДок.Область(Стр + 2, 1).Текст = "Методист деканата: " + Строка(Объект.Ответственный) + "   Подпись: ____________";
	ТабДок.Область("C1").ШиринаКолонки = 26;
	ТабДок.Область("C2").ШиринаКолонки = 48;
	ТабДок.АвтоМасштаб = Истина;

	Возврат ТабДок;

КонецФункции