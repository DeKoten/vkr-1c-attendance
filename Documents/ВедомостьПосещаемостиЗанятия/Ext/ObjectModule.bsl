Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если Не ЗначениеЗаполнено(УчебнаяГруппа) Или Не ЗначениеЗаполнено(Дисциплина)
		Или Не ЗначениеЗаполнено(ВидЗанятия) Или Не ЗначениеЗаполнено(Преподаватель) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Заполните обязательные поля шапки: группу, дисциплину, вид занятия и преподавателя.";
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;

	Если КоличествоЧасов <= 0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Количество академических часов занятия должно быть больше нуля.";
		Сообщение.Поле = "КоличествоЧасов";
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;

	Если Посещаемость.Количество() = 0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Табличная часть ""Посещаемость"" не заполнена.";
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;

	Для Каждого СтрокаТЧ Из Посещаемость Цикл
		Если Не ЗначениеЗаполнено(СтрокаТЧ.Обучающийся) Или Не ЗначениеЗаполнено(СтрокаТЧ.Статус) Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "В строке №" + СтрокаТЧ.НомерСтроки + " укажите обучающегося и статус посещаемости.";
			Сообщение.Сообщить();
			Отказ = Истина;
		КонецЕсли;
		Если СтрокаТЧ.Статус = Перечисления.СтатусыПосещаемости.Отсутствовал
			И Не ЗначениеЗаполнено(СтрокаТЧ.ПричинаПропуска) Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "В строке №" + СтрокаТЧ.НомерСтроки + " для отсутствующего обучающегося укажите причину пропуска.";
			Сообщение.Сообщить();
			Отказ = Истина;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	// Блокировка проведения ведомостей в закрытом учебном периоде
	Если УчетПосещаемостиСервер.ПериодЗакрытДляРедактирования(Дата) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Период по дату " + Формат(Дата, "ДФ=dd.MM.yyyy") + " уже закрыт документом ""Закрытие учебного периода"". Проведение запрещено.";
		Сообщение.Сообщить();
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Движения.ПосещаемостьОбучающихся.Записывать = Истина;
	Движения.ПропускиПоПричинам.Записывать = Истина;
	Движения.ОтработкаПропусков.Записывать = Истина;

	ТребуетОтработки = ВидЗанятия.ТребуетОтработки;
	ПродолжительностьЧаса = Константы.ПродолжительностьАкадемическогоЧаса.Получить();
	Если ПродолжительностьЧаса <= 0 Тогда
		ПродолжительностьЧаса = 45;
	КонецЕсли;

	Для Каждого СтрокаТЧ Из Посещаемость Цикл
		ДвижПос = Движения.ПосещаемостьОбучающихся.Добавить();
		ДвижПос.Период = Дата;
		ДвижПос.Обучающийся = СтрокаТЧ.Обучающийся;
		ДвижПос.УчебнаяГруппа = УчебнаяГруппа;
		ДвижПос.Дисциплина = Дисциплина;
		ДвижПос.Преподаватель = Преподаватель;
		ДвижПос.ВидЗанятия = ВидЗанятия;

		Если СтрокаТЧ.Статус = Перечисления.СтатусыПосещаемости.Присутствовал
			Или СтрокаТЧ.Статус = Перечисления.СтатусыПосещаемости.Дистанционно Тогда
			ДвижПос.ЧасыПосещено = КоличествоЧасов;
			ДвижПос.ЧасыПропущеноВсего = 0;
			ДвижПос.ЧасыОпозданий = 0;

		ИначеЕсли СтрокаТЧ.Статус = Перечисления.СтатусыПосещаемости.Опоздал Тогда
			ЧасыОпоздания = Окр(СтрокаТЧ.МинутОпоздания / ПродолжительностьЧаса, 2);
			Если ЧасыОпоздания > КоличествоЧасов Тогда
				ЧасыОпоздания = КоличествоЧасов;
			КонецЕсли;
			ДвижПос.ЧасыПосещено = КоличествоЧасов - ЧасыОпоздания;
			ДвижПос.ЧасыПропущеноВсего = 0;
			ДвижПос.ЧасыОпозданий = ЧасыОпоздания;

		ИначеЕсли СтрокаТЧ.Статус = Перечисления.СтатусыПосещаемости.Отсутствовал Тогда
			ДвижПос.ЧасыПосещено = 0;
			ДвижПос.ЧасыПропущеноВсего = КоличествоЧасов;
			ДвижПос.ЧасыОпозданий = 0;

			ДвижПроп = Движения.ПропускиПоПричинам.Добавить();
			ДвижПроп.Период = Дата;
			ДвижПроп.Обучающийся = СтрокаТЧ.Обучающийся;
			ДвижПроп.УчебнаяГруппа = УчебнаяГруппа;
			ДвижПроп.Дисциплина = Дисциплина;
			ДвижПроп.ПричинаПропуска = СтрокаТЧ.ПричинаПропуска;
			ДвижПроп.Уважительная = СтрокаТЧ.ПричинаПропуска.Уважительная;
			ДвижПроп.ЧасыПропусков = КоличествоЧасов;

			Если ТребуетОтработки Тогда
				ДвижОтр = Движения.ОтработкаПропусков.Добавить();
				ДвижОтр.ВидДвижения = ВидДвиженияНакопления.Приход;
				ДвижОтр.Период = Дата;
				ДвижОтр.Обучающийся = СтрокаТЧ.Обучающийся;
				ДвижОтр.Дисциплина = Дисциплина;
				ДвижОтр.ВидЗанятия = ВидЗанятия;
				ДвижОтр.ЧасыКОтработке = КоличествоЧасов;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры