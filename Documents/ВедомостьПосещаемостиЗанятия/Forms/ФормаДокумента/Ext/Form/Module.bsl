&НаКлиенте
Процедура ЗаполнитьПоГруппе(Команда)
	Если Не ЗначениеЗаполнено(Объект.УчебнаяГруппа) Тогда
		ПоказатьПредупреждение(, "Сначала выберите учебную группу в шапке документа.");
		Возврат;
	КонецЕсли;
	ЗаполнитьПоГруппеНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоГруппеНаСервере()
	Объект.Посещаемость.Очистить();
	ДатаСреза = ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДата());
	Студенты = УчетПосещаемостиСервер.ПолучитьАктивныхОбучающихсяГруппы(Объект.УчебнаяГруппа, ДатаСреза);
	Для Каждого Студент Из Студенты Цикл
		СтрокаТЧ = Объект.Посещаемость.Добавить();
		СтрокаТЧ.Обучающийся = Студент;
		СтрокаТЧ.Статус = Перечисления.СтатусыПосещаемости.Присутствовал;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ПараПриИзменении(Элемент)
	Если ЗначениеЗаполнено(Объект.Пара) Тогда
		Объект.КоличествоЧасов = ПолучитьЧасыПарыНаСервере(Объект.Пара);
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьЧасыПарыНаСервере(ПараСсылка)
	Часы = ПараСсылка.КоличествоАкадемЧасов;
	Возврат ?(Часы > 0, Часы, 2);
КонецФункции

&НаКлиенте
Процедура ПосещаемостьСтатусПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.Посещаемость.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ТекущаяСтрока.Статус = ПредопределенноеЗначение("Перечисление.СтатусыПосещаемости.Присутствовал")
		Или ТекущаяСтрока.Статус = ПредопределенноеЗначение("Перечисление.СтатусыПосещаемости.Дистанционно") Тогда
		ТекущаяСтрока.ПричинаПропуска = ПредопределенноеЗначение("Справочник.ПричиныПропусков.ПустаяСсылка");
		ТекущаяСтрока.МинутОпоздания = 0;
	ИначеЕсли ТекущаяСтрока.Статус = ПредопределенноеЗначение("Перечисление.СтатусыПосещаемости.Опоздал") Тогда
		ТекущаяСтрока.ПричинаПропуска = ПредопределенноеЗначение("Справочник.ПричиныПропусков.ПустаяСсылка");
		Если ТекущаяСтрока.МинутОпоздания = 0 Тогда
			ТекущаяСтрока.МинутОпоздания = 15;
		КонецЕсли;
	ИначеЕсли ТекущаяСтрока.Статус = ПредопределенноеЗначение("Перечисление.СтатусыПосещаемости.Отсутствовал") Тогда
		ТекущаяСтрока.МинутОпоздания = 0;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПечатьВедомости(Команда)
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПоказатьПредупреждение(, "Сначала запишите документ перед выводом на печать.");
		Возврат;
	КонецЕсли;
	ТабДок = СформироватьПечатнуюФормуНаСервере();
	ТабДок.ТолькоПросмотр = Истина;
	ТабДок.Показать("Ведомость посещаемости занятия № " + Объект.Номер);
КонецПроцедуры

&НаСервере
Функция СформироватьПечатнуюФормуНаСервере()

	ТабДок = Новый ТабличныйДокумент;

	// Заголовок
	ОбластьЗаг = ТабДок.Область(1, 1);
	ОбластьЗаг.Текст = "ВЕДОМОСТЬ ПОСЕЩАЕМОСТИ ЗАНЯТИЯ № " + Объект.Номер + " от " + Формат(Объект.Дата, "ДФ=dd.MM.yyyy");
	ОбластьЗаг.Шрифт = Новый Шрифт("Arial", 12, Истина);

	// Шапка с реквизитами
	ТабДок.Область(3, 1).Текст = "Учебная группа: " + Строка(Объект.УчебнаяГруппа);
	ТабДок.Область(4, 1).Текст = "Дисциплина: " + Строка(Объект.Дисциплина) + " (" + Строка(Объект.ВидЗанятия) + ")";
	ТабДок.Область(5, 1).Текст = "Преподаватель: " + Строка(Объект.Преподаватель) + " | Аудитория: " + Строка(Объект.Аудитория);
	ТабДок.Область(6, 1).Текст = "Пара: " + Строка(Объект.Пара) + " | Часов: " + Объект.КоличествоЧасов;

	// Шапка таблицы
	Заголовки = Новый Массив;
	Заголовки.Добавить("№");
	Заголовки.Добавить("Обучающийся");
	Заголовки.Добавить("Статус");
	Заголовки.Добавить("Причина пропуска");
	Заголовки.Добавить("Примечание");

	Рамка = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
	Для Индекс = 1 По 5 Цикл
		Ячейка = ТабДок.Область(8, Индекс);
		Ячейка.Текст = Заголовки[Индекс - 1];
		Ячейка.Шрифт = Новый Шрифт("Arial", 10, Истина);
		Ячейка.ГраницаСверху = Рамка;
		Ячейка.ГраницаСнизу = Рамка;
		Ячейка.ГраницаСлева = Рамка;
		Ячейка.ГраницаСправа = Рамка;
	КонецЦикла;

	// Строки таблицы
	НомерСтрокиТаб = 9;
	Для Каждого СтрокаТЧ Из Объект.Посещаемость Цикл
		Значения = Новый Массив;
		Значения.Добавить(Строка(СтрокаТЧ.НомерСтроки));
		Значения.Добавить(Строка(СтрокаТЧ.Обучающийся));
		Значения.Добавить(Строка(СтрокаТЧ.Статус));
		Значения.Добавить(Строка(СтрокаТЧ.ПричинаПропуска));
		Значения.Добавить(СтрокаТЧ.Примечание);

		Для Индекс = 1 По 5 Цикл
			Ячейка = ТабДок.Область(НомерСтрокиТаб, Индекс);
			Ячейка.Текст = Значения[Индекс - 1];
			Ячейка.ГраницаСверху = Рамка;
			Ячейка.ГраницаСнизу = Рамка;
			Ячейка.ГраницаСлева = Рамка;
			Ячейка.ГраницаСправа = Рамка;
		КонецЦикла;
		НомерСтрокиТаб = НомерСтрокиТаб + 1;
	КонецЦикла;

	ТабДок.Область(НомерСтрокиТаб + 2, 1).Текст = "Подпись преподавателя: ___________________";
	ТабДок.Область("C1").ШиринаКолонки = 5;
	ТабДок.Область("C2").ШиринаКолонки = 24;
	ТабДок.Область("C3").ШиринаКолонки = 16;
	ТабДок.Область("C4").ШиринаКолонки = 28;
	ТабДок.Область("C5").ШиринаКолонки = 22;
	ТабДок.АвтоМасштаб = Истина;

	Возврат ТабДок;

КонецФункции