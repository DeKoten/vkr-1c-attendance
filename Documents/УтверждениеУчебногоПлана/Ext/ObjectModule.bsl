  Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если Не ЗначениеЗаполнено(УчебнаяГруппа) Или Не ЗначениеЗаполнено(Семестр) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Укажите учебную группу и семестр.";
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;

	Если ДисциплиныПлана.Количество() = 0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Добавьте хотя бы одну дисциплину в учебный план.";
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;

	Для Каждого СтрокаТЧ Из ДисциплиныПлана Цикл
		Если СтрокаТЧ.ЧасовПоПлану <= 0 Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "В строке №" + СтрокаТЧ.НомерСтроки + " количество часов должно быть больше нуля.";
			Сообщение.Сообщить();
			Отказ = Истина;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	Движения.ПлановыеЧасыОбучения.Записывать = Истина;

	Для Каждого СтрокаТЧ Из ДисциплиныПлана Цикл
		Движение = Движения.ПлановыеЧасыОбучения.Добавить();
		Движение.Период = Дата;
		Движение.УчебнаяГруппа = УчебнаяГруппа;
		Движение.Дисциплина = СтрокаТЧ.Дисциплина;
		Движение.Семестр = Семестр;
		Движение.ВидЗанятия = СтрокаТЧ.ВидЗанятия;
		Движение.ЧасовПоПлану = СтрокаТЧ.ЧасовПоПлану;
	КонецЦикла;

КонецПроцедуры